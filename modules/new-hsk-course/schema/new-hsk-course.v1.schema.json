{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmngnaai.github.io/tieng-trung/modules/new-hsk-course/schema/new-hsk-course.v1.schema.json",
  "title": "New HSK Course lesson",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "courseId",
    "level",
    "lessonNumber",
    "title",
    "source",
    "stats",
    "entities",
    "views"
  ],
  "properties": {
    "schemaVersion": {
      "const": "new-hsk-course.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^nhsk-[1-9]-[0-9]{2}$"
    },
    "courseId": {
      "const": "new-hsk-course"
    },
    "level": {
      "type": "integer",
      "minimum": 1
    },
    "lessonNumber": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "$ref": "#/$defs/trilingualTitle"
    },
    "source": {
      "type": "object",
      "required": [
        "book",
        "pdfPages",
        "bookPages",
        "verificationStatus",
        "pageTrace"
      ],
      "properties": {
        "book": {
          "type": "string"
        },
        "pdfPages": {
          "type": "string"
        },
        "bookPages": {
          "type": "string"
        },
        "verificationStatus": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        },
        "dialogueData": {
          "type": "string"
        },
        "pageTrace": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pdfPage",
              "bookPage",
              "content",
              "status"
            ],
            "properties": {
              "pdfPage": {
                "type": "integer",
                "minimum": 1
              },
              "bookPage": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "stats": {
      "type": "object"
    },
    "entities": {
      "type": "object",
      "required": [
        "objectives",
        "lessonTexts",
        "vocabulary",
        "supplementalVocabulary",
        "properNouns",
        "dialogues",
        "languageNotes",
        "grammar",
        "examplesPractice",
        "exercises",
        "activities",
        "passages",
        "extensions",
        "contentSections"
      ],
      "properties": {
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orderedEntity"
          }
        },
        "lessonTexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lessonText"
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vocabulary"
          }
        },
        "supplementalVocabulary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplementalVocabulary"
          }
        },
        "properNouns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/properNoun"
          }
        },
        "dialogues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dialogue"
          }
        },
        "languageNotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orderedEntity"
          }
        },
        "grammar": {
          "type": "array"
        },
        "examplesPractice": {
          "type": "array"
        },
        "exercises": {
          "type": "array"
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orderedEntity"
          }
        },
        "passages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orderedEntity"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orderedEntity"
          }
        },
        "radicalSortExercises": {
          "type": "array"
        },
        "oddOneOutExercises": {
          "type": "array"
        },
        "characters": {
          "type": "array"
        },
        "characterBuildExercises": {
          "type": "array"
        },
        "contentSections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orderedEntity"
          }
        }
      },
      "additionalProperties": false
    },
    "practicePlan": {
      "type": "object"
    },
    "views": {
      "type": "object",
      "required": [
        "bookFlow",
        "groupedIndex"
      ],
      "properties": {
        "bookFlow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "groupedIndex": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "trilingualTitle": {
      "type": "object",
      "required": [
        "hanzi",
        "pinyin",
        "vi"
      ],
      "properties": {
        "hanzi": {
          "type": "string",
          "minLength": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1
        },
        "vi": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "orderedEntity": {
      "type": "object",
      "required": [
        "id",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "lessonText": {
      "allOf": [
        {
          "$ref": "#/$defs/orderedEntity"
        },
        {
          "type": "object",
          "required": [
            "title",
            "context",
            "instruction",
            "dialogueId",
            "vocabularyIds",
            "properNounIds",
            "languageNoteIds",
            "activityIds"
          ]
        }
      ]
    },
    "vocabulary": {
      "allOf": [
        {
          "$ref": "#/$defs/orderedEntity"
        },
        {
          "type": "object",
          "required": [
            "hanzi",
            "pinyin",
            "hanViet",
            "wordClass",
            "vi",
            "note",
            "lessonTextId"
          ]
        }
      ]
    },
    "supplementalVocabulary": {
      "allOf": [
        {
          "$ref": "#/$defs/orderedEntity"
        },
        {
          "type": "object",
          "required": [
            "hanzi",
            "pinyin",
            "wordClass",
            "vi",
            "classification",
            "sourceKind",
            "sourceContentSectionId",
            "officialLevelVocabulary",
            "isLessonNewWord",
            "flashcardEligible"
          ],
          "properties": {
            "hanzi": {
              "type": "string",
              "minLength": 1
            },
            "pinyin": {
              "type": "string"
            },
            "hanViet": {
              "type": "string"
            },
            "wordClass": {
              "type": "string"
            },
            "vi": {
              "type": "string"
            },
            "classification": {
              "const": "supplemental-vocabulary"
            },
            "sourceKind": {
              "type": "string"
            },
            "sourceSection": {
              "type": "string"
            },
            "sourceContentSectionId": {
              "type": "string"
            },
            "officialLevelVocabulary": {
              "type": "boolean"
            },
            "isLessonNewWord": {
              "const": false
            },
            "flashcardEligible": {
              "const": true
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "properNoun": {
      "allOf": [
        {
          "$ref": "#/$defs/orderedEntity"
        },
        {
          "type": "object",
          "required": [
            "hanzi",
            "pinyin",
            "hanViet",
            "kind",
            "vi",
            "lessonTextId"
          ]
        }
      ]
    },
    "dialogue": {
      "allOf": [
        {
          "$ref": "#/$defs/orderedEntity"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "lessonTextId",
            "sourceHeading",
            "context",
            "turns"
          ],
          "properties": {
            "turns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "order",
                  "speaker",
                  "hanzi",
                  "pinyin",
                  "vi",
                  "answerTokens"
                ],
                "properties": {
                  "speaker": {
                    "$ref": "#/$defs/trilingualTitle"
                  },
                  "answerTokens": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          }
        }
      ]
    }
  }
}
