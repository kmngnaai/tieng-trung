      "turns": [
        {
          "order": 1,
          "speaker_vi": "Vương Nhất Phi",
          "speaker_zh": "王一飞",
          "speaker_pinyin": "Wáng Yīfēi",
          "hanzi": "你们会说汉语了，也会写汉字了吗？",
          "pinyin": "Nǐmen huì shuō Hànyǔ le, yě huì xiě Hànzì le ma?",
          "vietnamese": "Các em đã biết nói tiếng Trung rồi, cũng đã biết viết chữ Hán chưa?"
        },
        {
          "order": 2,
          "speaker_vi": "Bạch Gia Nguyệt",
          "speaker_zh": "白家月",
          "speaker_pinyin": "Bái Jiāyuè",
          "hanzi": "我们都会写了。",
          "pinyin": "Wǒmen dōu huì xiě le.",
          "vietnamese": "Chúng em đều biết viết rồi ạ."
        },
        {
          "order": 3,
          "speaker_vi": "Trần Thiên Trung",
          "speaker_zh": "陈天中",
          "speaker_pinyin": "Chén Tiānzhōng",
          "hanzi": "老师，我听不见。",
          "pinyin": "Lǎoshī, wǒ tīng bu jiàn.",
          "vietnamese": "Thưa cô, em không nghe thấy."
