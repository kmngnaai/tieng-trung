          "speaker_vi": "Trần Thiên Trung",
          "speaker_zh": "陈天中",
          "speaker_pinyin": "Chén Tiānzhōng",
          "hanzi": "我看了一个电影。",
          "pinyin": "Wǒ kànle yí ge diànyǐng.",
          "vietnamese": "Tôi đã xem một bộ phim."
        }
      ]
