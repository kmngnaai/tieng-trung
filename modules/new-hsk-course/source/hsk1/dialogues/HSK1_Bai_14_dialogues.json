          "speaker_vi": "Vương Nhất Phi",
          "speaker_zh": "王一飞",
          "speaker_pinyin": "Wáng Yīfēi",
          "hanzi": "请大家不要说话！请听老师的问题：你们都会写哪些汉字了？",
          "pinyin": "Qǐng dàjiā búyào shuōhuà! Qǐng tīng lǎoshī de wèntí: Nǐmen dōu huì xiě nǎxiē Hànzì le?",
          "vietnamese": "Mọi người đừng nói chuyện! Hãy nghe câu hỏi của cô: Các em đã biết viết những chữ Hán nào rồi?"
        },
        {
          "order": 5,
          "speaker_vi": "Trần Thiên Trung",
          "speaker_zh": "陈天中",
          "speaker_pinyin": "Chén Tiānzhōng",
          "hanzi": "我会写这些字了，您看！",
          "pinyin": "Wǒ huì xiě zhèxiē zì le, nín kàn!",
          "vietnamese": "Em đã biết viết những chữ này rồi, cô xem ạ!"
        }
