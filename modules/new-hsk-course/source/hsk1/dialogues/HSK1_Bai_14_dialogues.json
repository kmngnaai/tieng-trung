          "speaker_vi": "Bạch Gia Nguyệt",
          "speaker_zh": "白家月",
          "speaker_pinyin": "Bái Jiāyuè",
          "hanzi": "你呢？",
          "pinyin": "Nǐ ne?",
          "vietnamese": "Còn bạn thì sao?"
