          "order": 4,
          "speaker_vi": "Lý Văn",
          "speaker_zh": "李文",
          "speaker_pinyin": "Lǐ Wén",
          "hanzi": "非常忙，我学医，我们的课很多。",
          "pinyin": "Fēicháng máng, wǒ xué yī, wǒmen de kè hěn duō.",
          "vietnamese": "Rất bận, tôi học y, chúng tôi có rất nhiều tiết học."
        }
