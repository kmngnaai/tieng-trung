      "turns": [
        {
          "order": 1,
          "speaker_vi": "Vương Nhất Phi",
          "speaker_zh": "王一飞",
          "speaker_pinyin": "Wáng Yīfēi",
          "hanzi": "你还在读大学吗？",
          "pinyin": "Nǐ hái zài dú dàxué ma?",
          "vietnamese": "Bạn vẫn đang học đại học à?"
        },
        {
          "order": 2,
          "speaker_vi": "Lý Văn",
          "speaker_zh": "李文",
          "speaker_pinyin": "Lǐ Wén",
          "hanzi": "对，我读大学呢，还是大学生。",
          "pinyin": "Duì, wǒ dú dàxué ne, hái shì dàxuéshēng.",
          "vietnamese": "Đúng, tôi đang học đại học, vẫn là sinh viên."
