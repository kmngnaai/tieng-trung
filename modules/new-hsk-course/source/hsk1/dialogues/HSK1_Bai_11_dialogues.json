        {
          "order": 1,
          "speaker_vi": "Lưu Minh",
          "speaker_zh": "刘明",
          "speaker_pinyin": "Liú Míng",
          "hanzi": "弟弟起床没起床呢？",
          "pinyin": "Dìdi qǐchuáng méi qǐchuáng ne?",
          "vietnamese": "Em trai đã dậy chưa?"
        },
        {
          "order": 2,
          "speaker_vi": "Lưu Tiểu Tuyết",
          "speaker_zh": "刘小雪",
          "speaker_pinyin": "Liú Xiǎoxuě",
          "hanzi": "没起床呢，还在睡觉。",
          "pinyin": "Méi qǐchuáng ne, hái zài shuìjiào.",
          "vietnamese": "Chưa dậy, vẫn đang ngủ."
        },
        {
          "order": 3,
          "speaker_vi": "Lưu Minh",
          "speaker_zh": "刘明",
          "speaker_pinyin": "Liú Míng",
          "hanzi": "还睡呢？他今天去不去那里？",
          "pinyin": "Hái shuì ne? Tā jīntiān qù bu qù nàli?",
          "vietnamese": "Vẫn ngủ à? Hôm nay nó có đi đến đó không?"
        },
        {
          "order": 4,
          "speaker_vi": "Lưu Tiểu Tuyết",
          "speaker_zh": "刘小雪",
          "speaker_pinyin": "Liú Xiǎoxuě",
          "hanzi": "去哪里？",
          "pinyin": "Qù nǎli?",
          "vietnamese": "Đi đâu ạ?"
