          "order": 5,
          "speaker_vi": "Lưu Minh",
          "speaker_zh": "刘明",
          "speaker_pinyin": "Liú Míng",
          "hanzi": "去超市。",
          "pinyin": "Qù chāoshì.",
          "vietnamese": "Đi siêu thị."
        },
        {
          "order": 6,
          "speaker_vi": "Lưu Tiểu Tuyết",
          "speaker_zh": "刘小雪",
          "speaker_pinyin": "Liú Xiǎoxuě",
          "hanzi": "我昨天问他，他对我说，他不去，他今天要和小朋友玩。",
          "pinyin": "Wǒ zuótiān wèn tā, tā duì wǒ shuō, tā bú qù, tā jīntiān yào hé xiǎopéngyou wán.",
          "vietnamese": "Hôm qua con đã hỏi em. Em nói với con là em không đi; hôm nay em muốn chơi với các bạn nhỏ."
