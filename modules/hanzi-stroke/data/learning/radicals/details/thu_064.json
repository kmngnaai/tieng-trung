  "shortForCharLookup": {
    "meaningLine": "Tay, hành động bằng tay.",
    "positionLine": "扌 thường nằm bên trái chữ, là dạng bộ thủ của 手.",
    "memoryLine": "Liên tưởng một bàn tay đang cầm, kéo, đẩy hoặc làm việc."
