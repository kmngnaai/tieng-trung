  "shortForCharLookup": {
    "meaningLine": "Cái cung để bắn",
    "positionLine": "弓 là dạng chính.",
    "memoryLine": "Bộ Cung 3 gõng | ‡ K Bộ Cung (5), nghĩa đà \"củng\", \"eung tên\", gong Trong Giáp Cốt văn chữ Cung rất giống hình cái cung, ở Kim Văn CUNG người ta bỏ phân dây cung đi và chữ dân biến đối như hiện nay: Ƒị trí của bộ phổ biến nhát là ở bên trái, đôi khi năm ở bên trên."
  },
  "detailForRadicalPopup": {
    "originMeaning": "Cái cung để bắn.\n\nSố đo đất, năm thước là một cung, tức là một \"bộ\", 360 bộ là một dặm, 240 bộ vuông là một \"mẫu\", vì thế nên cái thước đo đất gọi là \"bộ cung\" 步弓, người đo đất gọi là \"cung thủ\" 弓手.\n\nCong, vật gì hình cong như cái cung đều gọi là \"cung\", như \"cung yêu\" 弓腰 lưng cong.",
    "formVariants": [
      {
        "form": "弓",
        "pinyin": "gōng",
        "nameVi": "cung",
        "description": "Dạng chữ của Bộ Cung.",
