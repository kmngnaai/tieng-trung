  "structureExplanations": [
    {
      "textVi": "Chữ '边' gồm có bộ '辶' có nghĩa là 'đi, bước đi', thể hiện sự di chuyển hoặc thay đổi vị trí.",
      "source": "hsk_1.json",
      "reviewStatus": "source-backed"
    },
    {
      "textVi": "Phần bên trái là bộ '刀' nghĩa là 'dao', có thể gợi nhớ đến ý nghĩa của việc cắt hoặc tách ra, hàm ý về một ranh giới hoặc mép.",
      "source": "hsk_1.json",
      "reviewStatus": "source-backed"
    },
    {
      "textEn": "Simplified form of 邊. Phonosemantic compound with two sound components and two meaning components. 辶 and 方 represent the meaning, while 自 and 丙 represent the sound. The traditional component 自 was removed for simplification. The traditional component 丙 was removed for simplification.",
      "source": "dictionary.json",
      "reviewStatus": "source-backed"
    }
