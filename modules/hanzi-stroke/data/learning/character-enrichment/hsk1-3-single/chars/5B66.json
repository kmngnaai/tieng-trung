  "structureExplanations": [
    {
      "textVi": "Phần trên giống như một cái mái nhà, thường đại diện cho nơi học tập.",
      "source": "hsk_1.json",
      "reviewStatus": "source-backed"
    },
    {
      "textVi": "Phần dưới là chữ 子 (tử), có nghĩa là 'trẻ con', liên quan đến việc học hỏi.",
      "source": "hsk_1.json",
      "reviewStatus": "source-backed"
    },
    {
      "textEn": "Simplified form of 學. Originally composed of the numbers five (㐅) and six (六), representing study of arithmetic. Later two hands (又) were added on the left and right side of the character, possibly depicting counting with fingers or hands-on teaching. Finally a child (子) was added to the bottom, depicting a child being educated. The bottom part of 六 (six) was reanalyzed as 宀 (roof) and interpreted as a building for learning.",
      "source": "dictionary.json",
      "reviewStatus": "source-backed"
    }
  ],
