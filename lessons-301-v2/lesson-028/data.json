                          "confidence":  "high"
                      },
                      {
                          "id":  "s007",
                          "zh":  "那儿的天气跟这儿一样吗？",
                          "pinyin":  "Nàr de tiānqì gēn zhèr yīyàng ma?.",
                          "vi":  "Thời tiết ở đó có giống như ở đây không?",
