                          "confidence":  "high"
                      },
                      {
                          "id":  "s006",
                          "zh":  "明天比今天还冷呢。",
                          "pinyin":  "Míngtiān bǐ jīntiān hái lěng ne.",
                          "vi":  "Ngày mai còn lạnh hơn hôm nay nữa.",
